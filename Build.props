<Project Sdk="Microsoft.Build.Traversal">
  <ItemGroup>
    <ProjectReference Include="src/Sdk/Sdk.csproj" />
    <ProjectReference Include="src/Core/Core.csproj" />
    <ProjectReference Include="src/UseCases/UseCases.csproj" />
    <ProjectReference Include="src/Infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="src/Web/Web.csproj" />
    <ProjectReference Include="src/ServiceDefaults/ServiceDefaults.csproj" />
    <ProjectReference Include="src/AspireHost/AspireHost.csproj" />
    <ProjectReference Include="tests/UnitTests/UnitTests.csproj" />
    <ProjectReference Include="tests/IntegrationTests/IntegrationTests.csproj" />
    <ProjectReference Include="tests/FunctionalTests/FunctionalTests.csproj" />
  </ItemGroup>

  <!-- Aggregate target so you can: dotnet build -t:GenerateClients [-p:ApiBaseUrl=https://...] -->
  <Target Name="GenerateClients">
    <MSBuild Projects="src/Sdk/Sdk.csproj"
             Targets="GenerateSdkClient"
             Properties="ApiBaseUrl=$(ApiBaseUrl)" />
  </Target>
</Project>
